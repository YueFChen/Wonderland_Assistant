{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Wonderland Assistant",
  "version": "0.1.1",
  "identifier": "com.wonderland.assistant",
  "build": {
    "beforeDevCommand": "pnpm --dir ui dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "powershell -ExecutionPolicy Bypass -File scripts/build-tauri-assets.ps1",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Wonderland Assistant",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "decorations": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "externalBin": ["binaries/wla"],
    "publisher": "Yuef Chen",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "headerImage": "installer/nsis-header.bmp",
        "sidebarImage": "installer/nsis-sidebar.bmp",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "languages": ["SimpChinese", "English"]
      },
      "wix": {
        "bannerPath": "installer/wix-banner.bmp",
        "dialogImagePath": "installer/wix-dialog.bmp",
        "language": "zh-CN"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI4NEQyOUZCMDc5QUZDNApSV1RFcjNtd245S0VBdkFwYkkzZHVjMjdGV3FaWkN1dmFmWHpmOHg1M3oyR3ZiZTRla2tFMm9Oawo=",
      "endpoints": [
        "https://github.com/YueFChen/Wonderland_Assistant/releases/latest/download/latest.json"
      ]
    }
  }
}
