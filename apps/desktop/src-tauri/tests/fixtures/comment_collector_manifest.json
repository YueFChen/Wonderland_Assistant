{
  "manifestVersion": 3,
  "id": "comment_collector",
  "name": "Comment Archive Provider",
  "version": "0.1.0",
  "hostCompatibility": {
    "minCoreVersion": "0.1.0",
    "maxCoreVersionExclusive": "1.0.0",
    "protocol": {
      "minVersion": "1.0.0",
      "maxVersionExclusive": "2.0.0"
    }
  },
  "platform": {
    "os": "windows",
    "architecture": "x86_64",
    "abi": "msvc"
  },
  "ui": {
    "entry": "ui/index.html",
    "bridgeCompatibility": {
      "minVersion": "1.0.0",
      "maxVersionExclusive": "2.0.0"
    },
    "integrations": [],
    "contributions": [
      {
        "id": "main",
        "kind": "activity",
        "title": "Comment Archive",
        "defaultOrder": 0
      }
    ]
  },
  "backend": {
    "entry": "backend/provider.exe",
    "transport": "stdio-ndjson-v1"
  },
  "contract": "contract.json",
  "dependencies": []
}
