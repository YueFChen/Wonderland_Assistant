{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wonderland-core-updates",
  "main": "src/worker.mjs",
  "account_id": "58c3a089c5810ac7d56430a6f757ef69",
  "compatibility_date": "2026-10-06",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "updates.yuef.me", "custom_domain": true }],
  "vars": {
    "UPDATE_ORIGIN": "https://updates.yuef.me",
    "RELEASES_ENABLED": "true"
  },
  "r2_buckets": [{ "binding": "RELEASES", "bucket_name": "wonderland-core-releases" }],
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": false }
  }
}
