{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Core：运行桌面应用",
      "type": "node-terminal",
      "request": "launch",
      "command": "pnpm run dev",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Core：调试 Rust 宿主（LLDB）",
      "type": "lldb",
      "request": "launch",
      "cargo": {
        "args": ["build", "--locked", "--package=wonderland-desktop", "--bin=wonderland-desktop"],
        "filter": { "name": "wonderland-desktop", "kind": "bin" }
      },
      "cwd": "${workspaceFolder}",
      "sourceLanguages": ["rust"],
      "preLaunchTask": "Core: dev:ui"
    },
    {
      "name": "Core：调试 CLI（LLDB）",
      "type": "lldb",
      "request": "launch",
      "cargo": {
        "args": ["build", "--locked", "--package=wonderland-desktop", "--bin=wla"],
        "filter": { "name": "wla", "kind": "bin" }
      },
      "args": ["core", "status"],
      "cwd": "${workspaceFolder}",
      "sourceLanguages": ["rust"]
    }
  ]
}
