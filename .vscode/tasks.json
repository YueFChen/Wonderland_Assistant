{
  "version": "2.0.0",
  "options": {
    "cwd": "${workspaceFolder}"
  },
  "presentation": {
    "reveal": "always",
    "focus": false,
    "panel": "dedicated"
  },
  "tasks": [
    {
      "label": "Core: dev:ui",
      "type": "shell",
      "command": "pnpm",
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite",
        "fileLocation": [
          "relative",
          "${workspaceFolder}/apps/desktop/ui"
        ],
        "pattern": {
          "regexp": "^(.*?):(\\d+):(\\d+):\\s+(error|warning):\\s+(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "message": 5
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "\\bVITE\\b",
          "endsPattern": "\\bready in\\b"
        }
      },
      "args": [
        "run",
        "dev:ui"
      ],
      "runOptions": {
        "instanceLimit": 1
      }
    },
    {
      "label": "Core: build",
      "type": "shell",
      "command": "pnpm",
      "args": [
        "run",
        "build"
      ],
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Core: build:ui",
      "type": "shell",
      "command": "pnpm",
      "args": [
        "run",
        "build:ui"
      ],
      "problemMatcher": [],
      "group": "build"
    },
    {
      "label": "Core: build:cli",
      "type": "shell",
      "command": "pnpm",
      "args": [
        "run",
        "build:cli"
      ],
      "problemMatcher": [],
      "group": "build"
    },
    {
      "label": "Core: check",
      "type": "shell",
      "command": "pnpm",
      "args": [
        "run",
        "check"
      ],
      "problemMatcher": [],
      "group": {
        "kind": "test",
        "isDefault": true
      }
    },
    {
      "label": "Core: check:frontend",
      "type": "shell",
      "command": "pnpm",
      "args": [
        "run",
        "check:frontend"
      ],
      "problemMatcher": [],
      "group": "test"
    },
    {
      "label": "Core: check:rust",
      "type": "shell",
      "command": "pnpm",
      "args": [
        "run",
        "check:rust"
      ],
      "problemMatcher": [],
      "group": "test"
    }
  ]
}
